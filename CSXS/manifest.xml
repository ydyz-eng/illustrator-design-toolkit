<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.aitools.designtoolbox"
  ExtensionBundleVersion="1.3.0" ExtensionBundleName="AI设计工具箱">

  <ExtensionList>
    <Extension Id="com.aitools.designtoolbox.panel" Version="1.3.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Illustrator CC 2019 (23) 起允许加载；实际兼容性以宿主测试为准。 -->
      <Host Name="ILST" Version="[23.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.aitools.designtoolbox.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/tools.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AI 设计工具箱</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>400</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
          <Icons/>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
